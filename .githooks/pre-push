#!/bin/sh
set -eu

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
case "$branch" in
  SWolf|master) ;;
  *) exit 0 ;;
esac

tree=$(git rev-parse 'HEAD^{tree}')
gate=".local/quality-gates/$tree.json"
if [ ! -f "$gate" ]; then
  echo "Push blocked: run .\\tools\\verify.ps1 -Profile Fast first." >&2
  exit 1
fi
